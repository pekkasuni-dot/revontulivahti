{
  "appId": "fi.suni.auroraweather",
  "appName": "Aurora",
  "webDir": "www",
  "backgroundColor": "#070E20",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#070E20"
  },
  "android": {
    "backgroundColor": "#070E20"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
